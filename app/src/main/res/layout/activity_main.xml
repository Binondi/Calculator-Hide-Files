<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorSurfaceVariant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomExtraButtonsGuideline" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paddingLeftGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/_6sdp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paddingRightGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/_6sdp" />

    <View
        android:id="@+id/displayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        android:background="@drawable/bottom_corner"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pagerGuideline"
        app:layout_constraintTop_toTopOf="parent"/>

    <devs.org.calculator.views.CustomInputKeyBoard
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:gravity="end|bottom"
        android:minHeight="70dp"
        android:padding="10dp"
        android:textColor="@color/textColor"
        android:textSize="90sp"
        app:layout_constraintBottom_toTopOf="@+id/total"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="Suspicious0dp" />

    <TextView
        android:id="@+id/tvAngleMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="@string/deg"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/background_button_scientific"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/displayContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/total"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="38sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:gravity="end|bottom"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:text=""
        android:maxLines="2"
        android:textColor="@color/textColorDescription"
        android:textSize="40sp"
        app:layout_constraintBottom_toBottomOf="@+id/displayContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvAngleMode"
        tools:ignore="Suspicious0dp" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pagerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.34" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomExtraButtonsGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="91dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paddingBottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="@dimen/_3sdp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/ScientificTabLayout"
        android:layout_width="220dp"
        android:layout_height="34dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@drawable/background_tab_pill"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:tabIndicatorFullWidth="true"
        app:tabRippleColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/displayContainer" />

    <!-- Standard Keypad -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/paddingRightGuideline"
        app:layout_constraintStart_toStartOf="@id/paddingLeftGuideline"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout">

        <TextView
            android:id="@+id/btnClear"
            style="@style/Button.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="@string/all_clear"
            app:layout_constraintBottom_toTopOf="@+id/btn7"
            app:layout_constraintEnd_toStartOf="@+id/btnPercent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnPercent"
            style="@style/Button.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="@string/percentage"
            app:layout_constraintBottom_toTopOf="@+id/btn8"
            app:layout_constraintEnd_toStartOf="@+id/btnDivide"
            app:layout_constraintStart_toEndOf="@+id/btnClear"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnDivide"
            style="@style/Button.OperatorBigSize"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="@string/devide"
            app:layout_constraintBottom_toTopOf="@+id/btn9"
            app:layout_constraintEnd_toStartOf="@+id/cut"
            app:layout_constraintStart_toEndOf="@+id/btnPercent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cut"
            style="@style/Button.Backspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:tint="?attr/colorOnSurface"
            android:scaleType="centerInside"
            android:src="@drawable/backspace"
            app:layout_constraintBottom_toTopOf="@+id/btnMultiply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnDivide"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn7"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_7"
            app:layout_constraintBottom_toTopOf="@+id/btn4"
            app:layout_constraintEnd_toStartOf="@+id/btn8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnClear" />

        <TextView
            android:id="@+id/btn8"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_8"
            app:layout_constraintBottom_toTopOf="@+id/btn5"
            app:layout_constraintEnd_toStartOf="@+id/btn9"
            app:layout_constraintStart_toEndOf="@+id/btn7"
            app:layout_constraintTop_toBottomOf="@+id/btnPercent" />

        <TextView
            android:id="@+id/btn9"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_9"
            app:layout_constraintBottom_toTopOf="@+id/btn6"
            app:layout_constraintEnd_toStartOf="@+id/btnMultiply"
            app:layout_constraintStart_toEndOf="@+id/btn8"
            app:layout_constraintTop_toBottomOf="@+id/btnDivide" />

        <TextView
            android:id="@+id/btnMultiply"
            style="@style/Button.OperatorBigSize"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/into"
            app:layout_constraintBottom_toTopOf="@+id/btnMinus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn9"
            app:layout_constraintTop_toBottomOf="@+id/cut" />

        <TextView
            android:id="@+id/btn4"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_4"
            app:layout_constraintBottom_toTopOf="@+id/btn1"
            app:layout_constraintEnd_toStartOf="@+id/btn5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn7" />

        <TextView
            android:id="@+id/btn5"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_5"
            app:layout_constraintBottom_toTopOf="@+id/btn2"
            app:layout_constraintEnd_toStartOf="@+id/btn6"
            app:layout_constraintStart_toEndOf="@+id/btn4"
            app:layout_constraintTop_toBottomOf="@+id/btn8" />

        <TextView
            android:id="@+id/btn6"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_6"
            app:layout_constraintBottom_toTopOf="@+id/btn3"
            app:layout_constraintEnd_toStartOf="@+id/btnMinus"
            app:layout_constraintStart_toEndOf="@+id/btn5"
            app:layout_constraintTop_toBottomOf="@+id/btn9" />

        <TextView
            android:id="@+id/btnMinus"
            style="@style/Button.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/minus"
            app:layout_constraintBottom_toTopOf="@+id/btnPlus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn6"
            app:layout_constraintTop_toBottomOf="@+id/btnMultiply" />

        <TextView
            android:id="@+id/btn1"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_1"
            app:layout_constraintBottom_toTopOf="@+id/btn00"
            app:layout_constraintEnd_toStartOf="@+id/btn2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn4" />

        <TextView
            android:id="@+id/btn2"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_2"
            app:layout_constraintBottom_toTopOf="@+id/btn0"
            app:layout_constraintEnd_toStartOf="@+id/btn3"
            app:layout_constraintStart_toEndOf="@+id/btn1"
            app:layout_constraintTop_toBottomOf="@+id/btn5" />

        <TextView
            android:id="@+id/btn3"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_3"
            app:layout_constraintBottom_toTopOf="@+id/btnDot"
            app:layout_constraintEnd_toStartOf="@+id/btnPlus"
            app:layout_constraintStart_toEndOf="@+id/btn2"
            app:layout_constraintTop_toBottomOf="@+id/btn6" />

        <TextView
            android:id="@+id/btnPlus"
            style="@style/Button.OperatorBigSize"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/plus"
            app:layout_constraintBottom_toTopOf="@+id/btnEquals"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn3"
            app:layout_constraintTop_toBottomOf="@+id/btnMinus" />

        <TextView
            android:id="@+id/btn00"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn1" />

        <TextView
            android:id="@+id/btn0"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnDot"
            app:layout_constraintStart_toEndOf="@+id/btn00"
            app:layout_constraintTop_toBottomOf="@+id/btn2" />

        <TextView
            android:id="@+id/btnDot"
            style="@style/Button.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="@string/text_dot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnEquals"
            app:layout_constraintStart_toEndOf="@+id/btn0"
            app:layout_constraintTop_toBottomOf="@+id/btn3" />

        <TextView
            android:id="@+id/btnEquals"
            style="@style/Button.Equals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="@string/text_equal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnDot"
            app:layout_constraintTop_toBottomOf="@+id/btnPlus" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scientific Keypad -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scientificKeypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/paddingRightGuideline"
        app:layout_constraintStart_toStartOf="@id/paddingLeftGuideline"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout">

        <!-- Row 1: 2nd, DEG/RAD, sin, cos, tan -->
        <TextView
            android:id="@+id/btnSci2nd"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/second_func"
            app:layout_constraintBottom_toTopOf="@+id/btnSciPower"
            app:layout_constraintEnd_toStartOf="@+id/btnSciDegRad"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread" />

        <TextView
            android:id="@+id/btnSciDegRad"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/deg"
            app:layout_constraintBottom_toTopOf="@+id/btnSciLog"
            app:layout_constraintEnd_toStartOf="@+id/btnSciSin"
            app:layout_constraintStart_toEndOf="@+id/btnSci2nd"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnSciSin"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/sin"
            app:layout_constraintBottom_toTopOf="@+id/btnSciLn"
            app:layout_constraintEnd_toStartOf="@+id/btnSciCos"
            app:layout_constraintStart_toEndOf="@+id/btnSciDegRad"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnSciCos"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/cos"
            app:layout_constraintBottom_toTopOf="@+id/btnSciOpenParen"
            app:layout_constraintEnd_toStartOf="@+id/btnSciTan"
            app:layout_constraintStart_toEndOf="@+id/btnSciSin"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnSciTan"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/tan"
            app:layout_constraintBottom_toTopOf="@+id/btnSciCloseParen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnSciCos"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Row 2: xʸ, log, ln, (, ) -->
        <TextView
            android:id="@+id/btnSciPower"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/power"
            app:layout_constraintBottom_toTopOf="@+id/btnSciSqrt"
            app:layout_constraintEnd_toStartOf="@+id/btnSciLog"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSci2nd" />

        <TextView
            android:id="@+id/btnSciLog"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/log"
            app:layout_constraintBottom_toTopOf="@+id/btnSciClear"
            app:layout_constraintEnd_toStartOf="@+id/btnSciLn"
            app:layout_constraintStart_toEndOf="@+id/btnSciPower"
            app:layout_constraintTop_toBottomOf="@+id/btnSciDegRad" />

        <TextView
            android:id="@+id/btnSciLn"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/ln"
            app:layout_constraintBottom_toTopOf="@+id/btnSciCut"
            app:layout_constraintEnd_toStartOf="@+id/btnSciOpenParen"
            app:layout_constraintStart_toEndOf="@+id/btnSciLog"
            app:layout_constraintTop_toBottomOf="@+id/btnSciSin" />

        <TextView
            android:id="@+id/btnSciOpenParen"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/open_bracket"
            app:layout_constraintBottom_toTopOf="@+id/btnSciPercent"
            app:layout_constraintEnd_toStartOf="@+id/btnSciCloseParen"
            app:layout_constraintStart_toEndOf="@+id/btnSciLn"
            app:layout_constraintTop_toBottomOf="@+id/btnSciCos" />

        <TextView
            android:id="@+id/btnSciCloseParen"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/close_bracket"
            app:layout_constraintBottom_toTopOf="@+id/btnSciDivide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnSciOpenParen"
            app:layout_constraintTop_toBottomOf="@+id/btnSciTan" />

        <!-- Row 3: √, AC, Backspace, %, ÷ -->
        <TextView
            android:id="@+id/btnSciSqrt"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/sqrt"
            app:layout_constraintBottom_toTopOf="@+id/btnSciFactorial"
            app:layout_constraintEnd_toStartOf="@+id/btnSciClear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSciPower" />

        <TextView
            android:id="@+id/btnSciClear"
            style="@style/Button.Scientific.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/all_clear"
            app:layout_constraintBottom_toTopOf="@+id/btnSci7"
            app:layout_constraintEnd_toStartOf="@+id/btnSciCut"
            app:layout_constraintStart_toEndOf="@+id/btnSciSqrt"
            app:layout_constraintTop_toBottomOf="@+id/btnSciLog" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSciCut"
            style="@style/Button.Scientific.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/backspace"
            android:tint="?attr/colorOnSurface"
            app:layout_constraintBottom_toTopOf="@+id/btnSci8"
            app:layout_constraintEnd_toStartOf="@+id/btnSciPercent"
            app:layout_constraintStart_toEndOf="@+id/btnSciClear"
            app:layout_constraintTop_toBottomOf="@+id/btnSciLn" />

        <TextView
            android:id="@+id/btnSciPercent"
            style="@style/Button.Scientific.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/percentage"
            app:layout_constraintBottom_toTopOf="@+id/btnSci9"
            app:layout_constraintEnd_toStartOf="@+id/btnSciDivide"
            app:layout_constraintStart_toEndOf="@+id/btnSciCut"
            app:layout_constraintTop_toBottomOf="@+id/btnSciOpenParen" />

        <TextView
            android:id="@+id/btnSciDivide"
            style="@style/Button.Scientific.Operator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/devide"
            app:layout_constraintBottom_toTopOf="@+id/btnSciMultiply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnSciPercent"
            app:layout_constraintTop_toBottomOf="@+id/btnSciCloseParen" />

        <!-- Row 4: x!, 7, 8, 9, × -->
        <TextView
            android:id="@+id/btnSciFactorial"
            style="@style/Button.Scientific.Function"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/factorial"
            app:layout_constraintBottom_toTopOf="@+id/btnSciReciprocal"
            app:layout_constraintEnd_toStartOf="@+id/btnSci7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSciSqrt" />

        <TextView
            android:id="@+id/btnSci7"
            style="@style/Button.Scientific.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/text_7"
            app:layout_constraintBottom_toTopOf="@+id/btnSci4"
            app:layout_constraintEnd_toStartOf="@+id/btnSci8"
            app:layout_constraintStart_toEndOf="@+id/btnSciFactorial"
            app:layout_constraintTop_toBottomOf="@+id/btnSciClear" />

        <TextView
            android:id="@+id/btnSci8"
            style="@style/Button.Scientific.Number"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/text_8"
            app:layout_constraintBottom_toTopOf="@+id/btnSci5"
            app:layout_constraintEnd_toStartOf="@+id/btnSci9"
            app:layout_constraintStart_toEndOf="@+id/btnSci7"
            app:layout_constraintTop_toBottomOf="@+id/btnSciCut" />

        <TextView
            android:id="@+id/btnSci9"
            style="@style/Button.Scientific.Number"
            android:layout_width="0dp"
